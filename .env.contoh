# Salin menjadi .env di server (cp .env.contoh .env). Tidak ada rahasia di sini.
PORT=3100
BIND=127.0.0.1
DATA_DIR=/opt/affiliate-office/data
CLAUDE_MODE=cli
# Model untuk claude -p (kosongkan untuk bawaan akun)
CLAUDE_CLI_MODEL=
# Path claude jika tidak ada di PATH systemd, mis. /home/USER/.local/bin/claude
CLAUDE_BIN=
# Chrome untuk storyboard; kosong = dicari otomatis (termasuk chrome milik Remotion office lama)
CHROME_BIN=
FONT_DIR=/usr/share/fonts/opentype/inter
# Jumlah varian hook per klip (1-3)
JUMLAH_VARIAN=3
BATAS_UPLOAD_MB=300
